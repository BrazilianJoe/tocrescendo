# Neon Postgres
DATABASE_URL=postgresql://user:pass@host/db?sslmode=require

# Public canonical URL (without a trailing slash)
NEXT_PUBLIC_SITE_URL=https://www.tocrescendo.com.br

# Auth.js
AUTH_SECRET=generate-with-openssl-rand-base64-32

# Seed admin (scripts/seed-admin.ts)
ADMIN_EMAIL=admin@tocrescendo.com.br
ADMIN_PASSWORD=change-me
ADMIN_NAME=Michelle

# Vercel Blob (required in production for image uploads)
BLOB_STORE_ID=
BLOB_READ_WRITE_TOKEN=

# Publishing API. Generate the hash with: npm run api:token
# API_V1_AUTHOR_ID must be the UUID of an existing ADMIN user.
API_V1_TOKEN_HASH=sha256-hex-hash-goes-here
API_V1_AUTHOR_ID=00000000-0000-4000-8000-000000000000

# Protects /api/cron/publish-scheduled when called by Vercel Cron.
CRON_SECRET=replace-with-a-long-random-secret
